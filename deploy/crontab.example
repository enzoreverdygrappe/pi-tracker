# Crontab pi-tracker — à adapter puis installer avec : crontab -e
# Hypothèse : projet cloné dans /home/pi/pi-tracker

# Sync GitHub quotidien des données (23h15, heure locale du Pi)
15 23 * * * /home/pi/pi-tracker/sync.sh >> /home/pi/pi-tracker/logs/sync.log 2>&1

# Stats d'usage Claude Code toutes les heures — sur la machine où
# Claude Code tourne (parse local de ~/.claude, aucun appel réseau)
0 * * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/claude_stats.py collect >> logs/collect.log 2>&1

# Limites de plan Claude toutes les 30 min — à mettre sur la machine où
# Claude Code est connecté (le Mac, ou le Pi après 'claude' login) ;
# les données arrivent sur le Pi via le sync GitHub.
*/30 * * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/claude_limits.py collect >> logs/collect.log 2>&1

# Google Agenda toutes les 15 min
*/15 * * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/calendar_sync.py collect >> logs/collect.log 2>&1

# Météo toutes les 30 min
*/30 * * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/weather_sync.py collect >> logs/collect.log 2>&1

# Exemple de collecte périodique pour une future source de données :
# 0 * * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/<source>.py >> logs/collect.log 2>&1

# Données WHOOP toutes les 2 h (récupération/sommeil/strain des 7 derniers jours)
# Nécessite l'auth faite une fois (scripts/whoop.py auth) sur cette machine.
0 */2 * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/whoop.py collect >> logs/collect.log 2>&1

# Séances Kotcha via Garmin Connect toutes les heures, de 5 h à 22 h ; prépare la
# boucle du jour (onglet Course). Nécessite 'scripts/garmin_workouts.py auth' une fois.
0 5-22 * * * cd /home/pi/pi-tracker && /usr/bin/python3 scripts/garmin_workouts.py collect >> logs/collect.log 2>&1

# Rotation des logs : gérée par logrotate (deploy/pi-tracker.logrotate,
# installé par deploy/install.sh) + garde-fou dans sync.sh. Rien à ajouter ici.
