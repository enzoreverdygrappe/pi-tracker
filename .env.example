# Copier ce fichier en .env et remplir les valeurs.
# .env est dans .gitignore : il ne doit JAMAIS être commité.

# Clé API Anthropic (utile quand la collecte automatique sera branchée)
ANTHROPIC_API_KEY=

# WHOOP — créer une app sur https://developer-dashboard.whoop.com
# avec l'URI de redirection http://localhost:8399/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=http://localhost:8399/callback

# Google Calendar — identifiant OAuth « app de bureau » créé sur
# https://console.cloud.google.com (voir README, section Agenda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8400/callback

# Objectif financier (vue Goal, porté de money-mission-terminal)
GOAL_AMOUNT=25000
GOAL_DATE=2026-12-31
GOAL_START=2026-01-01
GOAL_CURRENCY=€

# Météo (Open-Meteo, sans clé) — défaut Paris ; pour changer de ville,
# remplacer les coordonnées (ex. Champagnole : 46.7456 / 5.9086)
WEATHER_LAT=48.8566
WEATHER_LON=2.3522
WEATHER_CITY=Paris

# Onglet Course : départ des boucles (coordonnées GPS, via openstreetmap.org)
RUN_HOME_LAT=
RUN_HOME_LON=
RUN_HOME_LABEL=Maison

# App mobile Course (~/ma-course sur Vercel) : elle garde les jetons Garmin et WHOOP,
# les connecteurs d'ici lui demandent un jeton d'accès (scripts/course_cloud.py).
# COURSE_SYNC_SECRET = la variable SYNC_SECRET du projet Vercel ma-course
COURSE_API_URL=
COURSE_SYNC_SECRET=
