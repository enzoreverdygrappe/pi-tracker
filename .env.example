# Copier ce fichier en .env et remplir les valeurs.
# .env est dans .gitignore : il ne doit JAMAIS être commité.

# Clé API Anthropic (utile quand la collecte automatique sera branchée)
ANTHROPIC_API_KEY=

# WHOOP — créer une app sur https://developer-dashboard.whoop.com
# avec l'URI de redirection http://localhost:8399/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=http://localhost:8399/callback

# Google Calendar — identifiant OAuth « app de bureau » créé sur
# https://console.cloud.google.com (voir README, section Agenda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8400/callback

# Objectif financier (vue Goal, porté de money-mission-terminal)
GOAL_AMOUNT=25000
GOAL_DATE=2026-12-31
GOAL_START=2026-01-01
GOAL_CURRENCY=€

# Météo (Open-Meteo, sans clé) — défaut Lyon ; pour changer de ville,
# remplacer les coordonnées (ex. Champagnole : 46.7456 / 5.9086)
WEATHER_LAT=45.7578
WEATHER_LON=4.8320
WEATHER_CITY=Lyon
